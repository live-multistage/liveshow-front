# Backend API base URL (include /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# External Ads Manager app — advertiser-facing ad campaign UI lives there now.
NEXT_PUBLIC_ADS_MANAGER_URL=http://localhost:3002

# Opaque token gating /broadcaster-dock/<token> — must match the OBS plugin's
# LIVESHOW_DOCK_TOKEN env var exactly. Never a NEXT_PUBLIC_ var (server-only check
# in middleware.ts). Generate a real random value for actual deployments; this is
# a placeholder for local dev.
LIVESHOW_DOCK_TOKEN=change-me-dock-token

# Secret for on-demand web cache revalidation. Server-only. Must match
# WEB_REVALIDATE_SECRET in the orchestrator backend.
# Generate with: openssl rand -hex 32
WEB_REVALIDATE_SECRET=

# Analytics SDK write key. Unset → TrackingProvider renders children only,
# tracking is off for this deploy.
NEXT_PUBLIC_TRACKING_WRITE_KEY=
